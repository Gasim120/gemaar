{
    "title": "subscriptions",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "user_id": {
            "type": "string",
            "description": "User ID"
        },
        "plan": {
            "type": "string",
            "description": "Plan type: free, monthly, yearly"
        },
        "images_used": {
            "type": "integer",
            "description": "Number of images used in current period"
        },
        "images_limit": {
            "type": "integer",
            "description": "Maximum images allowed"
        },
        "is_active": {
            "type": "boolean",
            "description": "Whether subscription is active"
        },
        "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
        },
        "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration timestamp"
        }
    },
    "required": [
        "id",
        "user_id"
    ]
}